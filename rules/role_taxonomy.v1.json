  {"role_family": "COMMERCIAL", "terms": ["comercial", "ventas", "sales"]},
  {"role_family": "FINANCE", "terms": ["financiero", "financiera", "finanzas", "administracion", "contabilidad", "tesoreria", "cfo"]},
  {"role_family": "IT_OPERATIONS", "terms": ["sistemas", "tecnologia", "informatica", "digital", "transformacion digital", "operaciones", "produccion", "cio", "cto", "coo", "it"]}
 ],
 "seniority_rules": [
  {"seniority": "C_LEVEL", "terms": ["director general", "directora general", "consejero delegado", "consejera delegada", "ceo", "cfo", "cio", "cto", "coo", "presidente", "presidenta", "gerente", "managing director"]},
  {"seniority": "DIRECTOR", "terms": ["director", "directora", "head of", "vp"]},
