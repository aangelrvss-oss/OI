{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "opportunity_contact.v1.schema.json",
 "title": "opportunity_contact.v1",
 "description": "A QUIÉN contactar en una empresa candidata y POR QUÉ. Separa el DESTINO (target: persona/departamento/empresa) del CANAL (cómo llegar). evidence_strength mide la fiabilidad del dato; contact_quality mide su utilidad comercial: un email general oficial puede tener evidencia HIGH y calidad GENERIC. Nunca se rellena con suposiciones: sin evidencia accionable, recommended_contact = null.",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "contract_version",
  "company_ref",
  "opportunity_type",
  "offering_kind",
  "contact_profile_id",
  "enrichment_state",
  "levels_reached",
  "channels",
  "people",
  "role_contacts",
  "recommended_contact",
  "alternatives",
  "not_recommended",
  "evidence",
  "contradictions",
  "not_found",
  "last_verified",
  "cost",
  "selection_blocked"
 ],
 "properties": {
  "contract_version": {
   "const": "opportunity_contact.v1"
  },
  "company_ref": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "company_id",
    "name"
   ],
   "properties": {
    "company_id": {
     "$ref": "common.v1.schema.json#/$defs/non_empty_string"
    },
    "name": {
     "$ref": "common.v1.schema.json#/$defs/non_empty_string"
    },
    "domain": {
     "type": [
      "string",
      "null"
     ]
    }
   }
  },
  "opportunity_type": {
   "$ref": "common.v1.schema.json#/$defs/opportunity_type"
  },
  "offering_kind": {
   "$ref": "common.v1.schema.json#/$defs/offering_kind"
  },
  "target_function": {
   "$ref": "common.v1.schema.json#/$defs/target_function"
  },
  "contact_profile_id": {
   "type": [
    "string",
    "null"
   ],
   "description": "Perfil de rules/contact_profiles.v1.json usado. null = no se pudo elegir perfil (p. ej. offering.kind UNKNOWN): entonces NO hay recomendación."
  },
  "enrichment_state": {
   "enum": [
    "PENDING",
    "LEVEL0_DONE",
    "LEVEL1_DONE",
    "LEVEL1_BLOCKED",
    "FREE_ENRICHMENT_EXHAUSTED",
    "AWAITING_USER_DECISION",
    "PAID_DONE"
   ]
  },
  "levels_reached": {
   "type": "array",
   "items": {
    "enum": [
     0,
     1,
     2,
     3
    ]
   },
   "uniqueItems": true
  },
  "channels": {
   "type": "array",
   "items": {
    "$ref": "#/$defs/channel"
   }
  },
  "people": {
   "type": "array",
   "items": {
    "$ref": "#/$defs/person"
   }
  },
  "role_contacts": {
   "type": "array",
   "items": {
    "$ref": "#/$defs/role_contact"
   }
  },
  "recommended_contact": {
   "oneOf": [
    {
     "type": "null"
    },
    {
     "$ref": "#/$defs/recommended"
    }
   ]
  },
  "alternatives": {
   "type": "array",
   "maxItems": 3,
   "items": {
    "$ref": "#/$defs/recommended"
   }
  },
  "not_recommended": {
   "type": "array",
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "ref",
     "reason"
    ],
    "properties": {
     "ref": {
      "type": "string",
      "minLength": 1
     },
     "reason": {
      "type": "string",
      "minLength": 1
     }
    }
   }
  },
  "evidence": {
   "type": "array",
   "items": {
    "$ref": "common.v1.schema.json#/$defs/evidence"
   }
  },
  "contradictions": {
   "type": "array",
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "field",
     "description",
     "state"
    ],
    "properties": {
     "field": {
      "type": "string",
      "minLength": 1
     },
     "description": {
      "type": "string",
      "minLength": 1
     },
     "values": {
      "type": "array",
      "items": {
       "type": [
        "string",
        "number",
        "boolean"
       ]
      }
     },
     "state": {
      "const": "AMBIGUOUS"
     }
    }
   }
  },
  "not_found": {
   "type": "array",
   "items": {
    "type": "string",
    "minLength": 1
   }
  },
  "last_verified": {
   "oneOf": [
    {
     "type": "null"
    },
    {
     "$ref": "common.v1.schema.json#/$defs/date"
    }
   ]
  },
  "cost": {
   "$ref": "#/$defs/cost"
  },
  "selection_blocked": {
   "oneOf": [
    {
     "type": "null"
    },
    {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "code",
      "message"
     ],
     "properties": {
      "code": {
       "enum": [
        "OFFERING_KIND_REQUIRED",
        "NO_PROFILE_FOR_COMBINATION",
        "AMBIGUOUS_PROFILE"
       ]
      },
      "message": {
       "type": "string",
       "minLength": 1
      }
     }
    }
   ],
   "description": "Por qué NO se pudo elegir perfil/recomendar (p. ej. offering.kind desconocido). Explica lo que el sistema no sabe."
  }
 },
 "allOf": [
  {
   "if": {
    "properties": {
     "contact_profile_id": {
      "type": "null"
     }
    },
    "required": [
     "contact_profile_id"
    ]
   },
   "then": {
    "properties": {
     "recommended_contact": {
      "type": "null"
     },
     "alternatives": {
      "maxItems": 0
     }
    }
   }
  },
  {
   "if": {
    "properties": {
     "enrichment_state": {
      "enum": [
       "PAID_DONE"
      ]
     }
    },
    "required": [
     "enrichment_state"
    ]
   },
   "then": {
    "properties": {
     "cost": {
      "properties": {
       "paid_enrichment_authorized": {
        "const": true
       }
      }
     }
    }
   }
  }
 ],
 "$defs": {
  "channel": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "channel_id",
    "kind",
    "value",
    "scope",
    "purpose",
    "evidence_ids"
   ],
   "properties": {
    "channel_id": {
     "type": "string",
     "minLength": 1
    },
    "kind": {
     "enum": [
      "EMAIL",
      "PHONE",
      "FORM",
      "PORTAL",
      "LINKEDIN",
      "POSTAL"
     ]
    },
    "value": {
     "type": "string",
     "minLength": 1
    },
    "scope": {
     "enum": [
      "PERSON",
      "DEPARTMENT",
      "COMPANY"
     ]
    },
    "purpose": {
     "enum": [
      "GENERAL",
      "COMMERCIAL",
      "PROCUREMENT",
      "SUPPORT",
      "PRESS",
      "LEGAL",
      "DPO",
      "UNKNOWN"
     ]
    },
    "evidence_ids": {
     "type": "array",
     "minItems": 1,
     "items": {
      "type": "string",
      "minLength": 1
     },
     "description": "Todo canal necesita al menos una evidencia: sin evidencia no hay canal (no se inventan emails)."
    },
    "person_id": {
     "type": [
      "string",
      "null"
     ]
    },
    "usable_for_outreach": {
     "type": "boolean",
     "description": "Derivado de purpose (SUPPORT/PRESS/LEGAL/DPO no lo son), nunca asignado a mano."
    },
    "role_family": {
     "oneOf": [
      {
       "type": "null"
      },
      {
       "$ref": "#/$defs/role_family"
      }
     ],
     "description": "A qué familia de rol pertenece un canal de DEPARTAMENTO (obligatorio si scope=DEPARTMENT)."
    },
    "outreach_access": {
     "enum": [
      "OPEN",
      "RESTRICTED",
      "UNKNOWN"
     ],
     "description": "¿Admite el canal un primer contacto del tipo buscado? OPEN solo con evidencia explícita (p. ej. formulario de alta de proveedores). Un portal 'para proveedores existentes' o 'sin formulario de alta' es RESTRICTED; sin información, UNKNOWN. Un canal que no es OPEN nunca es DIRECT."
    }
   },
   "allOf": [
    {
     "if": {
      "properties": {
       "kind": {
        "const": "EMAIL"
       }
      },
      "required": [
       "kind"
      ]
     },
     "then": {
      "properties": {
       "value": {
        "pattern": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$"
       }
      }
     }
    },
    {
     "if": {
      "properties": {
       "kind": {
        "enum": [
         "FORM",
         "PORTAL",
         "LINKEDIN"
        ]
       }
      },
      "required": [
       "kind"
      ]
     },
     "then": {
      "properties": {
       "value": {
        "pattern": "^https?://"
       }
      }
     }
    },
    {
     "if": {
      "properties": {
       "scope": {
        "const": "PERSON"
       }
      },
      "required": [
       "scope"
      ]
     },
     "then": {
      "required": [
       "person_id"
      ],
      "properties": {
       "person_id": {
        "type": "string",
        "minLength": 1
       }
      }
     }
    },
    {
     "if": {
      "properties": {
       "scope": {
        "const": "DEPARTMENT"
       }
      },
      "required": [
       "scope"
      ]
     },
     "then": {
      "required": [
       "role_family"
      ],
      "properties": {
       "role_family": {
        "$ref": "#/$defs/role_family"
       }
      }
     }
    }
   ]
  },
  "person": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "person_id",
    "name",
    "title",
    "role_family",
    "role_evidence_ids",
    "channel_ids",
    "employment_verified_at"
   ],
   "properties": {
    "person_id": {
     "type": "string",
     "minLength": 1
    },
    "name": {
     "type": "string",
     "minLength": 1
    },
    "title": {
     "type": "string",
     "minLength": 1
    },
    "department": {
     "type": [
      "string",
      "null"
     ]
    },
    "role_family": {
     "$ref": "#/$defs/role_family"
    },
    "seniority": {
     "enum": [
      "C_LEVEL",
      "DIRECTOR",
      "MANAGER",
      "STAFF",
      "UNKNOWN"
     ]
    },
    "role_evidence_ids": {
     "type": "array",
     "minItems": 1,
     "items": {
      "type": "string",
      "minLength": 1
     }
    },
    "channel_ids": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "employment_verified_at": {
     "oneOf": [
      {
       "type": "null"
      },
      {
       "$ref": "common.v1.schema.json#/$defs/date"
      }
     ]
    }
   }
  },
  "role_family": {
   "enum": [
    "PROCUREMENT",
    "COMMERCIAL",
    "DECISION_MAKER",
    "BUSINESS_DEV",
    "IT_OPERATIONS",
    "FINANCE",
    "MANAGEMENT",
    "GENERAL"
   ]
  },
  "role_contact": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "role_family",
    "person_ids",
    "channel_ids"
   ],
   "properties": {
    "role_family": {
     "$ref": "#/$defs/role_family"
    },
    "person_ids": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "channel_ids": {
     "type": "array",
     "items": {
      "type": "string"
     }
    }
   }
  },
  "contact_quality": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "target_fit",
    "reachability",
    "evidence_strength",
    "freshness",
    "grade"
   ],
   "properties": {
    "target_fit": {
     "enum": [
      "EXACT",
      "ADJACENT",
      "GENERIC"
     ],
     "description": "Cuánto se parece el destino al rol objetivo del perfil de contacto."
    },
    "reachability": {
     "enum": [
      "DIRECT",
      "INDIRECT",
      "NONE"
     ]
    },
    "evidence_strength": {
     "$ref": "common.v1.schema.json#/$defs/evidence_strength",
     "description": "Mínimo de fuerza entre las evidencias del destino y de la vía. Derivado."
    },
    "freshness": {
     "enum": [
      "CURRENT",
      "STALE",
      "UNKNOWN"
     ]
    },
    "grade": {
     "enum": [
      "A",
      "B",
      "C",
      "D"
     ],
     "description": "Etiqueta derivada por reglas de rules/contact_profiles.v1.json; no es una puntuación."
    }
   }
  },
  "recommended": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "target",
    "ref",
    "via_channel_id",
    "why_this_contact",
    "next_action",
    "contact_quality"
   ],
   "properties": {
    "target": {
     "enum": [
      "PERSON",
      "DEPARTMENT",
      "COMPANY"
     ]
    },
    "ref": {
     "type": "string",
     "minLength": 1,
     "description": "person_id si target=PERSON; channel_id del canal departamental/de empresa en otro caso."
    },
    "via_channel_id": {
     "type": [
      "string",
      "null"
     ]
    },
    "ladder_rung": {
     "type": [
      "string",
      "null"
     ],
     "description": "Peldaño del perfil que hizo coincidir este destino (trazabilidad)."
    },
    "why_this_contact": {
     "type": "string",
     "minLength": 1
    },
    "next_action": {
     "type": "string",
     "minLength": 1
    },
    "contact_quality": {
     "$ref": "#/$defs/contact_quality"
    }
   }
  },
  "cost": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "paid_calls",
    "credits",
    "paid_enrichment_authorized"
   ],
   "properties": {
    "paid_calls": {
     "type": "integer",
     "minimum": 0
    },
    "credits": {
     "type": "number",
     "minimum": 0
    },
    "paid_enrichment_authorized": {
     "type": "boolean"
    },
    "authorization_ref": {
     "type": [
      "string",
      "null"
     ]
    }
   },
   "allOf": [
    {
     "if": {
      "properties": {
       "paid_enrichment_authorized": {
        "const": false
       }
      },
      "required": [
       "paid_enrichment_authorized"
      ]
     },
     "then": {
      "properties": {
       "paid_calls": {
        "const": 0
       },
       "credits": {
        "const": 0
       }
      }
     }
    }
   ]
  }
 }
}