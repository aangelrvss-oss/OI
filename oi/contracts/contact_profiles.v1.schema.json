{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "contact_profiles.v1.schema.json",
 "title": "contact_profiles.v1",
 "type": "object", "additionalProperties": false,
 "required": ["profiles_version", "contract", "description", "hard_filters", "freshness_policy", "evidence_strength_order", "small_company", "grading", "reachability_rules", "profiles"],
 "properties": {
  "profiles_version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
  "contract": {"const": "opportunity_contact.v1"},
  "description": {"type": "string"},
  "hard_filters": {"type": "object", "required": ["excluded_channel_purposes", "allowed_claim_status", "disallowed_source_classes"]},
  "freshness_policy": {"type": "object", "required": ["person_max_age_days", "channel_max_age_days"], "properties": {"person_max_age_days": {"type": "integer", "minimum": 1}, "channel_max_age_days": {"type": "integer", "minimum": 1}}},
  "evidence_strength_order": {"type": "array", "minItems": 4, "items": {"$ref": "common.v1.schema.json#/$defs/evidence_strength"}},
  "small_company": {"type": "object", "required": ["max_employees", "applies_only_with_evidence"], "properties": {"max_employees": {"type": "integer", "minimum": 1}, "applies_only_with_evidence": {"const": true}}},
  "grading": {"type": "object", "additionalProperties": false, "required": ["description", "rules", "default"],
              "properties": {"description": {"type": "string"}, "default": {"enum": ["A", "B", "C", "D"]},
                             "rules": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["grade", "when"], "properties": {"grade": {"enum": ["A", "B", "C", "D"]}, "when": {"type": "object", "additionalProperties": {"type": "array", "minItems": 1, "items": {"type": "string"}}}}}}}},
  "reachability_rules": {"type": "object", "required": ["DIRECT", "INDIRECT", "NONE"]},
  "profiles": {"type": "object", "minProperties": 1, "additionalProperties": {
    "type": "object", "additionalProperties": false, "required": ["description", "applies_to", "ladder"],
    "properties": {
     "description": {"type": "string"},
     "applies_to": {"type": "object", "additionalProperties": false, "required": ["opportunity_type", "offering_kind"],
                    "properties": {"opportunity_type": {"type": "array", "minItems": 1, "items": {"$ref": "common.v1.schema.json#/$defs/opportunity_type"}}, "offering_kind": {"type": "array", "minItems": 1, "items": {"$ref": "common.v1.schema.json#/$defs/offering_kind"}}}},
     "function_to_role_family": {"type": "object", "additionalProperties": {"type": "array", "minItems": 1, "items": {"type": "string"}}},
     "unknown_function_role_families": {"type": "array", "minItems": 1, "items": {"type": "string"}},
     "unknown_function_note": {"type": "string"},
     "ladder": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["id", "fit", "match", "label"],
                "properties": {"id": {"type": "string", "minLength": 1}, "fit": {"enum": ["EXACT", "ADJACENT", "GENERIC"]}, "label": {"type": "string"}, "requires_small_company": {"type": "boolean"},
                               "match": {"type": "object", "minProperties": 1, "additionalProperties": false,
                                         "properties": {"target": {"type": "array", "items": {"enum": ["PERSON", "DEPARTMENT", "COMPANY"]}}, "role_family": {"type": "array", "items": {"type": "string"}}, "seniority": {"type": "array", "items": {"type": "string"}},
                                                        "channel_kind": {"type": "array", "items": {"type": "string"}}, "channel_purpose": {"type": "array", "items": {"type": "string"}}}}}}}
    }}}
 }
}
