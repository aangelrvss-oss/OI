{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "sector_mapping.v1.schema.json",
 "title": "sector_mapping.v1",
 "description": "Traduce el término del usuario ('constructoras') a criterios de descubrimiento compatibles con las fuentes. Los códigos de clasificación y las consultas a proveedor son DATOS CURADOS con evidencia: un LLM nunca crea un CNAE/NAICS. Si un término no está aquí, el resultado es MAPPING_REQUIRED (no se convierte a la fuerza).",
 "type": "object", "additionalProperties": false,
 "required": ["mapping_version", "country", "language", "policy", "entries"],
 "properties": {
  "mapping_version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
  "country": {"type": "string", "pattern": "^[A-Z]{2}$"},
  "language": {"type": "string", "minLength": 2},
  "policy": {"type": "object", "additionalProperties": false, "required": ["unmapped_term", "llm_may_create_codes", "provider_query_must_be_probed_before_reliance"],
             "properties": {"unmapped_term": {"const": "MAPPING_REQUIRED"}, "llm_may_create_codes": {"const": false}, "provider_query_must_be_probed_before_reliance": {"type": "boolean"}, "note": {"type": "string"}}},
  "entries": {"type": "array", "minItems": 1, "items": {
   "type": "object", "additionalProperties": false,
   "required": ["entry_id", "user_terms", "canonical_sector", "classification", "business_model_hint", "provider_taxonomy", "provider_query", "confidence", "evidence", "review"],
   "properties": {
    "entry_id": {"type": "string", "minLength": 1},
    "user_terms": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "canonical_sector": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"},
    "classification": {"type": "object", "additionalProperties": false, "required": ["cnae_2009", "naics_2022"],
                       "properties": {"cnae_2009": {"oneOf": [{"type": "null"}, {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["code", "title", "verification"],
                                         "properties": {"code": {"type": "string", "minLength": 1}, "title": {"type": "string", "minLength": 1}, "verification": {"enum": ["VERIFIED_OFFICIAL", "VERIFIED_THIRD_PARTY_REPRODUCTION", "NOT_VERIFIED_THIS_SESSION"]}}}}]},
                                      "naics_2022": {"oneOf": [{"type": "null"}, {"type": "array", "items": {"type": "object"}}]},
                                      "note": {"type": "string"}}},
    "business_model_hint": {"type": "array", "items": {"enum": ["manufacturer", "distributor", "retailer", "service_provider", "contractor", "operator", "unknown"]}},
    "provider_taxonomy": {"type": "object", "additionalProperties": {"type": "object", "required": ["status"], "properties": {"status": {"enum": ["USED_IN_HISTORICAL_RUN", "PROPOSED_NOT_PROBED", "VERIFIED", "MAPPING_REQUIRED"]}}}},
    "provider_query": {"type": "object", "additionalProperties": {"type": "object", "required": ["status", "params"], "properties": {"status": {"enum": ["USED_IN_HISTORICAL_RUN", "PROPOSED_NOT_PROBED", "VERIFIED", "MAPPING_REQUIRED"]}, "params": {"type": "object"}, "note": {"type": "string"}}}},
    "confidence": {"enum": ["HIGH", "MEDIUM", "LOW"]},
    "evidence": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["source_label", "retrieved_at", "supports"], "properties": {"source_label": {"type": "string", "minLength": 1}, "source_url": {"type": ["string", "null"]}, "retrieved_at": {"$ref": "common.v1.schema.json#/$defs/date"}, "supports": {"type": "string", "minLength": 1}}}},
    "review": {"type": "object", "additionalProperties": false, "required": ["status", "reviewed_by"], "properties": {"status": {"enum": ["PENDING_HUMAN_REVIEW", "REVIEWED"]}, "reviewed_by": {"type": ["string", "null"]}}}
   }}}
 }
}
